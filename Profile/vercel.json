{
  "version": 2,
  "buildCommand": "npm run build --workspaces",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "/packages/backend/src/main.ts" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/packages/frontend/dist/$1" 
    }
  ],
  "functions": {
    "packages/backend/src/main.ts": {
      "runtime": "@vercel/node",
      "includeFiles": "packages/backend/dist/**"
    }
  }
}