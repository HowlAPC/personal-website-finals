{
  "compilerOptions": {
    "module": "CommonJS", 
    "moduleResolution": "node",
    "target": "es2017",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "baseUrl": "./",
    "outDir": "./dist",
    "skipLibCheck": true,
    "strict": true
  }
}